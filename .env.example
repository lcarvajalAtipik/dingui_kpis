# --- BigQuery ---
# Auth recomendada: ADC vía `gcloud auth application-default login` (no hace falta SA JSON).
BQ_PROJECT=
BQ_DATASET=dingui_kpis
BQ_LOCATION=EU
BQ_MAX_BYTES_BILLED=104857600
# Solo si se usa service account JSON (normalmente NO — la org policy lo bloquea):
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Tipsi (PoS) ---
# Extractor autoservicio (scripts/tipsi_extract.py): solo necesita email+password del back
# office. Login = GET /api/Login/LoginWeb con Basic → cookie de sesión.
TIPSI_EMAIL=info@dinguiclub.com
TIPSI_PASSWORD=
# brandId/localId (GUIDs): se autodetectan; rellénalos solo para saltarte la detección.
TIPSI_BRAND_ID=
TIPSI_LOCAL_ID=
# Base URL de la API (por defecto backend-green.tipsipro.com si se deja vacío):
TIPSI_API_BASE=

# --- OpenRouter (clasificación/extracción batch con LLMs) ---
OPENROUTER_API_KEY=
