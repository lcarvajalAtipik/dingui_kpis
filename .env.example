# --- BigQuery ---
# Auth recomendada: ADC vía `gcloud auth application-default login` (no hace falta SA JSON).
BQ_PROJECT=
BQ_DATASET=dingui_kpis
BQ_LOCATION=EU
BQ_MAX_BYTES_BILLED=104857600
# Solo si se usa service account JSON (normalmente NO — la org policy lo bloquea):
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Tipsi (PoS) ---
# Mecanismo de acceso por confirmar (API vs exports del back office).
TIPSI_API_BASE=
TIPSI_API_USER=
TIPSI_API_TOKEN=

# --- OpenRouter (clasificación/extracción batch con LLMs) ---
OPENROUTER_API_KEY=
